---
import { CONTACT_HREF } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<footer class="footer">
  <div class="wrap foot-row">
    <span>© 2026 Dragonfruit AI. Openbox is a <a href="https://dragonfruit.ai/" target="_blank" rel="noopener">Dragonfruit AI</a> company.</span>
    <nav class="foot-links" aria-label="Footer">
      <a href={`${base}#twin`}>Twin</a>
      <a href={`${base}#monitoring`}>Watch</a>
      <a href={`${base}about/`}>About</a>
      <a href={CONTACT_HREF}>Contact</a>
    </nav>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); font-size: 13.5px; color: var(--ink-3); }
  .foot-row { display: flex; justify-content: space-between; gap: 16px; padding-block: 26px; flex-wrap: wrap; }
  .footer a { color: var(--ink-2); text-decoration: none; }
  .footer a:hover { color: var(--ink); }
  .foot-links { display: flex; gap: 20px; }
</style>
