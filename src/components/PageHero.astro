---
interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow ph-k"><span class="signal-dot"></span>{eyebrow}</p>
    <h1 class="display"><slot name="title" /></h1>
    <p class="ph-lede"><slot name="lede" /></p>
  </div>
</section>

<style>
  .page-hero {
    background: var(--grain), radial-gradient(110% 90% at 80% 20%, #1d1d1b 0%, #0c0c0b 65%);
    color: #fff; padding-block: 220px 128px;
  }
  .ph-k { display: inline-flex; align-items: center; gap: 10px; color: rgba(255,255,255,.62); margin: 0 0 22px; }
  .page-hero h1 { font-size: clamp(48px, 8vw, 112px); line-height: .96; margin: 0 0 28px; }
  .page-hero h1 :global(em) { color: var(--signal); }
  .ph-lede { margin: 0; font-size: clamp(17px, 1.6vw, 21px); color: rgba(255,255,255,.72); max-width: 48ch; }
</style>
