---
import { DEMO_HREF, DEMO_IS_EXTERNAL } from "../data/site";

const externalAttrs = DEMO_IS_EXTERNAL ? { target: "_blank", rel: "noopener" } : {};
---
<section class="pilot" id="pilot">
  <div class="pilot-card">
    <p class="eyebrow pilot-k">Free 30-day pilot</p>
    <h2 class="display">Start with one project.</h2>
    <p class="pilot-lede">We connect your cameras. You see the results on your own site. Then you decide.</p>
    <a class="btn pilot-cta" href={DEMO_HREF} {...externalAttrs}>Book a demo</a>
  </div>
</section>

<style>
  .pilot { background: var(--paper); padding: 0 12px 12px; }
  .pilot-card {
    background: var(--accent); color: #fff; border-radius: 14px;
    padding: clamp(64px, 10vw, 136px) clamp(24px, 6vw, 96px);
    display: grid; justify-items: start; gap: 22px;
  }
  .pilot-k { color: rgba(255,255,255,.66); margin: 0; }
  .pilot h2 { font-size: clamp(44px, 7vw, 96px); margin: 0; }
  .pilot-lede { margin: 0 0 12px; font-size: clamp(17px, 1.6vw, 20px); color: rgba(255,255,255,.76); max-width: 40ch; }
  .pilot-cta { background: #fff; color: var(--ink); }
  .pilot-cta:hover { background: #dbe8ff; }
</style>
