---
const steps = [
  {
    name: "Capture",
    line: "Headcams, drones and site cameras land on one timeline, placed on your plans.",
    specs: ["Site cameras · RTSP or ONVIF", "Headcams · daily", "Drones · weekly", "Plans + P6 or MS Project"],
  },
  {
    name: "Detect",
    line: "Video models find the work, the people and the risks, zone by zone.",
    specs: ["Activity by zone and level", "PPE and exclusion zones", "Gate and deliveries", "After-hours intrusion"],
  },
  {
    name: "Verify",
    line: "A person reviews each milestone and each alert before it reaches you.",
    specs: ["Milestone review", "Alert review", "Clip kept as evidence"],
  },
  {
    name: "Report",
    line: "Your team gets the record, not another dashboard to watch.",
    specs: ["Daily site report", "Actual dates on your schedule", "Alerts to your team or guard", "Search any day on site"],
  },
];
---
<section class="section how" id="how-it-works">
  <div class="wrap">
    <p class="eyebrow how-k">The workflow</p>
    <h2 class="display how-head">From capture to record,<br /><em>every day.</em></h2>
    <div class="how-flow">
    <span class="how-rail" aria-hidden="true"><span class="how-pulse"></span></span>
    <ol class="how-grid">
      {steps.map((s, i) => (
        <li class="how-step">
          <span class="how-n mono"><span class="how-node" aria-hidden="true"></span>0{i + 1} {s.name}</span>
          <p class="how-line">{s.line}</p>
          <ul class="how-specs mono">
            {s.specs.map((x) => <li>{x}</li>)}
          </ul>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<style>
  .how { background: var(--stone) var(--grain); border-block: 1px solid var(--line); }
  .how-k { margin: 0 0 14px; }
  .how-head { font-size: clamp(40px, 6vw, 76px); margin: 0 0 72px; }
  .how-head em { color: var(--ink-3); }
  .how-flow { position: relative; }
  .how-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .how-rail { position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: var(--line-strong); overflow: hidden; }
  .how-pulse { position: absolute; top: 0; left: -20%; width: 20%; height: 1px; background: linear-gradient(90deg, transparent, var(--ink), transparent); animation: how-run 6s cubic-bezier(.6,0,.4,1) infinite; }
  @keyframes how-run { to { left: 100%; } }
  .how-step { position: relative; display: grid; gap: 14px; align-content: start; }
  .how-n { position: relative; width: fit-content; padding-right: 14px; background: var(--stone); display: inline-flex; align-items: center; gap: 12px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); }
  .how-node { width: 15px; height: 15px; border-radius: 50%; background: var(--paper); border: 1px solid var(--ink); box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 8px var(--ink); }
  .how-step:last-child .how-node { box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 8px var(--signal-ink); border-color: var(--signal-ink); }
  .how-line { margin: 4px 0 0; font-family: var(--serif); font-size: clamp(22px, 2vw, 26px); line-height: 1.15; max-width: 22ch; }
  .how-specs { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 0; font-size: 12px; letter-spacing: .04em; color: var(--ink-2); }
  .how-specs li { padding: 9px 0; border-top: 1px solid var(--line); }
  .how-specs li:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 920px) {
    .how-grid { grid-template-columns: repeat(2, 1fr); row-gap: 48px; }
    .how-rail { display: none; }
  }
  @media (max-width: 560px) {
    .how-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .how-pulse { animation: none; display: none; }
  }
</style>
