---
import { VERTICALS } from "../data/product";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<section class="verticals">
  <div class="wrap">
    <p class="eyebrow v-k">Where it works</p>
    <h2 class="display v-head">One record,<br /><em>every kind of job.</em></h2>
    <ul class="v-list">
      {VERTICALS.map((v, i) => (
        <li>
          <span class="v-n mono">0{i + 1}</span>
          <span class="v-name display">{v.name}</span>
          <span class="v-line">{v.line}</span>
        </li>
      ))}
    </ul>
    <div class="proof">
      <span class="proof-n display">100,000+</span>
      <span class="proof-t">live cameras run on the Dragonfruit AI video platform that powers Openbox.</span>
      <a class="proof-df" href="https://dragonfruit.ai/" target="_blank" rel="noopener">
        <img src={`${base}images/brand/dragonfruit-logo.svg`} alt="Dragonfruit AI" width="150" height="27" />
      </a>
    </div>
  </div>
</section>

<style>
  .verticals { padding-block: clamp(96px, 13vw, 168px) clamp(72px, 9vw, 112px); }
  .v-k { margin: 0 0 14px; color: rgba(255,255,255,.55); }
  .v-head { font-size: clamp(40px, 6vw, 80px); margin: 0 0 56px; }
  .v-head em { color: rgba(255,255,255,.46); }
  .v-list { list-style: none; margin: 0; padding: 0; }
  .v-list li {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; gap: 20px;
    padding: 26px 0; border-top: 1px solid rgba(255,255,255,.16);
    transition: padding-left .3s ease, color .3s ease;
  }
  .v-list li:last-child { border-bottom: 1px solid rgba(255,255,255,.16); }
  .v-list li:hover { padding-left: 12px; }
  .v-list li:hover .v-name { color: var(--signal); }
  .v-n { font-size: 12px; letter-spacing: .14em; color: rgba(255,255,255,.4); }
  .v-name { font-size: clamp(34px, 5vw, 68px); line-height: 1; transition: color .3s ease; }
  .v-line { color: rgba(255,255,255,.62); max-width: 34ch; justify-self: end; text-align: right; }
  .proof { margin-top: 88px; display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .proof-n { font-size: clamp(48px, 7vw, 96px); line-height: 1; color: var(--signal); }
  .proof-t { color: rgba(255,255,255,.7); max-width: 40ch; flex: 1 1 280px; }
  .proof-df img { display: block; height: 27px; width: auto; opacity: .8; }
  .proof-df:hover img { opacity: 1; }
  @media (max-width: 720px) {
    .v-list li { grid-template-columns: 32px minmax(0, 1fr); row-gap: 8px; padding: 22px 0; }
    .v-line { grid-column: 2; justify-self: start; text-align: left; }
  }
</style>
