      </div>

      <div class="sheet card" id="plan-panel" role="tabpanel" aria-labelledby="tab-twin" data-panel>
        <div class="sheet-canvas">
          <svg viewBox="0 0 960 600" role="img" aria-label="Level 3 floor plan with camera coverage, a 360° walk path and a drone flight" data-svg>
            <defs>
              <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#deded8" stroke-width="1.2" />
              </pattern>
            </defs>
            <rect x="20" y="20" width="920" height="560" rx="4" fill="#fff" stroke="#c9c9c2" />

            {gridX.map((g) => (
              <g class="gridline">
                <line x1={g.x} y1="72" x2={g.x} y2="462" />
                <circle cx={g.x} cy="54" r="15" />
                <text x={g.x} y="59" text-anchor="middle">{g.label}</text>
              </g>
            ))}
            {gridY.map((g) => (
              <g class="gridline">
                <line x1="78" y1={g.y} x2="862" y2={g.y} />
                <circle cx="58" cy={g.y} r="15" />
                <text x="58" y={g.y + 5} text-anchor="middle">{g.label}</text>
              </g>
            ))}

            {zones.map((z) => (
              <g class="zone" data-zone={z.id} data-state="pending">
                <rect class="zone-fill" x={z.x + 6} y={z.y + 6} width={z.w - 12} height={z.h - 12} rx="3" />
                <text class="zone-name" x={z.x + 18} y={z.y + 32}>{z.name}</text>
                <text class="zone-state" x={z.x + 18} y={z.y + 52}>PENDING</text>
              </g>
            ))}

            <g class="dim">
              <line x1="140" y1="490" x2="500" y2="490" />
              <line x1="140" y1="482" x2="140" y2="498" />
              <line x1="500" y1="482" x2="500" y2="498" />
              <text x="320" y="484" text-anchor="middle">60'-0"</text>
            </g>
            <g class="level">
              <path d="M140 528 l9 14 l9 -14 z" />
              <text x="168" y="541">LEVEL 3 · EL. +40'-6"</text>
            </g>

            <rect class="night" x="21" y="21" width="918" height="558" rx="4" />

            <g class="layer layer-cams">
              {[...cameras, ...cameras2].map((c) => (
                <g class={`cam${c.id === "CAM-08" ? " cam-gate" : ""}`}>
                  <path class="cone" d={cone(c.x, c.y, c.angle)} />
                  <rect x={c.x - 9} y={c.y - 6} width="18" height="12" rx="3" />
                  <text x={c.lx} y={c.ly} text-anchor={c.anchor}>{c.id}</text>
                </g>
              ))}
            </g>

            <g class="layer layer-twin">
              <polyline class="walk" points={walk.map((p) => p.join(",")).join(" ")} />
              {walk.map(([x, y]) => <circle class="walk-pt" cx={x} cy={y} r="5" />)}
              <text class="layer-label" x="190" y="438">360° WALK · THU</text>
              <g class="drone" transform="translate(590 96)">
                <line x1="-12" y1="-8" x2="12" y2="8" /><line x1="-12" y1="8" x2="12" y2="-8" />
                <circle cx="-12" cy="-8" r="4" /><circle cx="12" cy="8" r="4" /><circle cx="-12" cy="8" r="4" /><circle cx="12" cy="-8" r="4" />
              </g>
              <text class="layer-label" x="610" y="100">DRONE · WED</text>
            </g>

            <g class="layer layer-watch">
              <path class="fence" d="M520 472 L82 472 L82 80 L876 80 L876 472 L600 472" />
              <text class="watch-label" x="560" y="500" text-anchor="middle">GATE 2 · PLATE READER</text>
              <rect class="vehicle" x="548" y="440" width="24" height="30" rx="4" />
              <circle class="swing" cx="230" cy="390" r="64" />
              <rect class="crane" x="224" y="384" width="12" height="12" />
              <line class="crane-jib" x1="230" y1="390" x2="290" y2="350" />
              <text class="watch-label" x="304" y="432">CRANE SWING ZONE</text>
              <circle class="ring" cx="262" cy="352" r="16" />
              <circle class="worker flag" cx="262" cy="352" r="6" />
              <circle class="worker flag" cx="380" cy="402" r="6" />
              <text class="watch-label" x="394" y="406">NO HARD HAT</text>
              <circle class="worker" cx="430" cy="220" r="6" />
              <circle class="worker" cx="560" cy="240" r="6" />
              <circle class="worker" cx="620" cy="380" r="6" />
              <text class="watch-label" x="470" y="106" text-anchor="middle">MONITORING · SAFETY · LOGISTICS · SECURITY</text>
            </g>

            <g class="titleblock">
              <rect x="660" y="484" width="264" height="80" />
              <line x1="660" y1="512" x2="924" y2="512" />
              <text x="672" y="503">HARBOR ST · BLDG B</text>
              <text x="672" y="534" data-sheet-title>LEVEL 3 — SITE RECORD</text>
              <text x="672" y="553">SHEET A-301</text>
              <text x="912" y="553" text-anchor="end" data-sheet-day>FRI</text>
            </g>
          </svg>
          <svg class="iso" viewBox="0 0 960 600" aria-hidden="true">
            <rect x="20" y="20" width="920" height="560" rx="4" fill="#fff" stroke="#c9c9c2" />
            <polygon class="iso-ground" points={top(-50, -40, 450, 210, 0)} />
            <polygon class="iso-face-l done" points={faceLeft(0, H)} />
            <polygon class="iso-face-r done" points={faceRight(0, H)} />
            <polygon class="iso-face-l done" points={faceLeft(H, 2 * H)} />
            <polygon class="iso-face-r done" points={faceRight(H, 2 * H)} />
            <polyline class="iso-floorline" points={poly([iso(0, ISO.d, H), iso(ISO.w, ISO.d, H), iso(ISO.w, 0, H)])} />
            <polygon class="iso-deck-base" points={top(0, 0, ISO.w, ISO.d, 2 * H)} />
            {deckTiles.map((t) => <polygon class={`iso-tile ${t.state}`} points={t.points} />)}
            {columns.map(([x, y]) => (
              <line class="iso-col" x1={iso(x, y, 2 * H)[0]} y1={iso(x, y, 2 * H)[1]} x2={iso(x, y, 3 * H)[0]} y2={iso(x, y, 3 * H)[1]} />
            ))}
            <polygon class="iso-form" points={top(0, 0, ISO.w, ISO.d, 3 * H)} />
            <line class="iso-crane" x1={cranePts.base[0]} y1={cranePts.base[1]} x2={cranePts.mast[0]} y2={cranePts.mast[1]} />
            <line class="iso-crane" x1={cranePts.jibA[0]} y1={cranePts.jibA[1]} x2={cranePts.jibB[0]} y2={cranePts.jibB[1]} />
            <line class="iso-hook" x1={iso(300, 40, 4.4 * H)[0]} y1={iso(300, 40, 4.4 * H)[1]} x2={iso(300, 40, 3.4 * H)[0]} y2={iso(300, 40, 3.4 * H)[1]} />

            <g class="iso-labels">
              <line x1={labelAt(ISO.w, 0, 3 * H)[0]} y1={labelAt(ISO.w, 0, 3 * H)[1]} x2="742" y2={labelAt(ISO.w, 0, 3 * H)[1]} />
              <text x="748" y={labelAt(ISO.w, 0, 3 * H)[1] + 4}>L4 · FORMWORK</text>
              <line x1={labelAt(ISO.w, ISO.d / 4, 2 * H)[0]} y1={labelAt(ISO.w, ISO.d / 4, 2 * H)[1]} x2="742" y2={labelAt(ISO.w, ISO.d / 4, 2 * H)[1]} />
              <text x="748" y={labelAt(ISO.w, ISO.d / 4, 2 * H)[1] + 4}>L3 DECK · 3/6 POURED</text>
              <line x1={labelAt(0, ISO.d, H / 2)[0]} y1={labelAt(0, ISO.d, H / 2)[1]} x2="206" y2={labelAt(0, ISO.d, H / 2)[1]} />
              <text x="200" y={labelAt(0, ISO.d, H / 2)[1] + 4} text-anchor="end">L1–L2 · COMPLETE</text>
            </g>
            <g class="iso-legend">
              <rect x="44" y="44" width="12" height="12" class="lg done" /><text x="64" y="54">VERIFIED</text>
              <rect x="44" y="64" width="12" height="12" class="lg progress" /><text x="64" y="74">IN PROGRESS</text>
              <rect x="44" y="84" width="12" height="12" class="lg pending" /><text x="64" y="94">NOT STARTED</text>
              <text x="44" y="124" class="iso-note">BUILT FROM PLANS + DRONE CAPTURES · BIM OPTIONAL</text>
            </g>
            <g class="titleblock">
              <rect x="660" y="484" width="264" height="80" />
              <line x1="660" y1="512" x2="924" y2="512" />
              <text x="672" y="503">HARBOR ST · BLDG B</text>
              <text x="672" y="534">3D MODEL — PROGRESS</text>
              <text x="672" y="553">VIEW 3D-001</text>
              <text x="912" y="553" text-anchor="end">FRI</text>
            </g>
          </svg>
          <div class="chip card" data-chip hidden>
            <span class="chip-top"><span class="signal-dot"></span><span data-chip-title></span></span>
            <span class="chip-meta mono" data-chip-meta></span>
          </div>
        </div>
      </div>

      <div class="timeline">
        <div class="scrub">
          <span class="eyebrow" data-scrub-label>Captures this week</span>
          <div class="scrub-control" data-scrub-wrap>
            <input id="plan-scrub" type="range" min="0" max="4" step="0.01" value="4" aria-label="Scrub through the week" data-scrub />
            <div class="days mono" aria-hidden="true">
              {days.map((d) => <span>{d}</span>)}
            </div>
          </div>
          <p class="mode-note" data-mode-note></p>
        </div>
        <ol class="ledger mono" data-ledger aria-live="off"></ol>
      </div>
    </div>
    <p class="stage-note mono">One site, four views: site record, 3D model, progress and site monitoring</p>
  </div>
</section>

<script>
  type Mode = "twin" | "model" | "progress" | "watch";
  type ZoneState = "pending" | "progress" | "done";
  interface PlanEvent { t: number; zone: string; state: ZoneState; title: string; time: string; source: string; }
  interface LedgerRow { time: string; text: string; tag: string; }
  interface ModeView { label: string; note: string; title: string; chip: { x: number; y: number; title: string; meta: string }; ledger: LedgerRow[]; }

  const EVENTS: PlanEvent[] = [
    { t: 0.25, zone: "A", state: "progress", title: "Rebar placing", time: "Mon 08:20", source: "CAM-04" },
    { t: 0.9, zone: "D", state: "progress", title: "Formwork up", time: "Mon 15:10", source: "CAM-06" },
    { t: 1.35, zone: "B", state: "progress", title: "Rebar placing", time: "Tue 09:05", source: "Drone" },
    { t: 2.2, zone: "A", state: "done", title: "Slab poured", time: "Wed 10:42", source: "CAM-04" },
    { t: 2.7, zone: "C", state: "progress", title: "Rebar placing", time: "Wed 16:30", source: "CAM-02" },
    { t: 3.1, zone: "E", state: "progress", title: "Formwork up", time: "Thu 09:12", source: "360° walk" },
    { t: 3.4, zone: "B", state: "done", title: "Slab poured", time: "Thu 14:05", source: "Drone" },
    { t: 3.95, zone: "D", state: "done", title: "Slab poured", time: "Fri 11:15", source: "CAM-06" },
  ];
  const VIEWS: Record<Exclude<Mode, "progress">, ModeView> = {
    twin: {
      label: "Captures this week",
      note: "Every capture is placed on the plan. Step back to any date to see the site as it was.",
      title: "LEVEL 3 — SITE RECORD",
      chip: { x: 520, y: 282, title: "360° walk placed on A-301", meta: "THU 09:12 · 214 FRAMES · 6 ZONES" },
      ledger: [
        { time: "Live", text: "CAM-02, CAM-04, CAM-06 streaming", tag: "3 cameras" },
        { time: "Thu 09:12", text: "360° walk · 214 frames placed", tag: "A-301" },
        { time: "Tue 09:05", text: "Drone flight · whole deck", tag: "drone map" },
        { time: "Mon 11:05", text: "Phone video · Zone B close-ups", tag: "phone" },
      ],
    },
    model: {
      label: "3D model",
      note: "See the building in 3D, built from your plans and drone captures, with BIM as an optional overlay. Every level and zone shows its verified status.",
      title: "LEVEL 3 — SITE RECORD",
      chip: { x: 520, y: 300, title: "Level 3 deck · 3 of 6 zones poured", meta: "FRI · DRONE + CAMERAS · VERIFIED BY A REVIEWER" },
      ledger: [
        { time: "L4", text: "Formwork starts Monday", tag: "schedule" },
        { time: "L3 deck", text: "Zones A, B, D poured", tag: "verified" },
        { time: "L3 deck", text: "Zones C, E in progress", tag: "detected" },
        { time: "L1–L2", text: "Structure complete", tag: "verified" },
      ],
    },
    watch: {
      label: "Today on site",
      note: "Safety, logistics and security on the same cameras, day and night. A person reviews each alert before your team is notified.",
      title: "SITE PLAN — MONITORING",
      chip: { x: 262, y: 340, title: "Worker in crane swing zone", meta: "10:02 · CAM-06 · REVIEWED · SITE LEAD ALERTED" },
      ledger: [
        { time: "10:14", text: "No hard hat · Zone D", tag: "PPE · reviewed" },
        { time: "10:02", text: "Worker in crane swing zone", tag: "safety · alerted" },
        { time: "09:48", text: "Concrete truck at Gate 2", tag: "plate · matches delivery" },
        { time: "02:14", text: "Vehicle on site after hours", tag: "security · reviewed" },
      ],
    },
  };
  const STATE_LABEL: Record<ZoneState, string> = { pending: "NOT STARTED", progress: "IN PROGRESS · DETECTED", done: "COMPLETE · VERIFIED" };
  const DAYS = ["MON", "TUE", "WED", "THU", "FRI"];
  const ZONE_CENTER: Record<string, [number, number]> = {
    A: [230, 272], B: [410, 272], C: [670, 272], D: [320, 432], E: [590, 432], F: [760, 432],
  };
  const PROGRESS_MS = 3400;
  const TOUR_STEPS: { mode: Mode; hold: number }[] = [
    { mode: "twin", hold: 2600 },
    { mode: "model", hold: 3000 },
    { mode: "progress", hold: PROGRESS_MS + 1400 },
    { mode: "watch", hold: 0 },
  ];
  const LEDGER_SIZE = 4;
  const SVG_LABEL: Record<Mode, string> = {
    twin: "Level 3 floor plan with camera coverage, a 360° walk path and a drone flight",
    model: "3D model of the building: levels 1 and 2 complete, level 3 deck partly poured, level 4 formwork and a tower crane",
    progress: "Level 3 floor plan with zones marked not started, in progress or complete",
    watch: "Site plan with a crane swing zone, a worker missing a hard hat, and a truck at the gate plate reader",
  };

  function setup(root: HTMLElement) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const scrub = q<HTMLInputElement>("[data-scrub]");
    const scrubWrap = q<HTMLElement>("[data-scrub-wrap]");
    const scrubLabel = q<HTMLElement>("[data-scrub-label]");
    const note = q<HTMLElement>("[data-mode-note]");
    const ledger = q<HTMLOListElement>("[data-ledger]");
    const chip = q<HTMLElement>("[data-chip]");
    const chipTitle = q<HTMLElement>("[data-chip-title]");
    const chipMeta = q<HTMLElement>("[data-chip-meta]");
    const sheetDay = q<SVGTextElement>("[data-sheet-day]");
    const sheetTitle = q<SVGTextElement>("[data-sheet-title]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panel = q<HTMLElement>("[data-panel]");
    const svg = q<SVGSVGElement>("[data-svg]");
    const zones = new Map<string, SVGGElement>();
    root.querySelectorAll<SVGGElement>("[data-zone]").forEach((z) => zones.set(z.dataset.zone!, z));

    let mode: Mode = "twin";
    let lastChipKey = "";
    let raf = 0;
    const timers: number[] = [];

    function showChip(x: number, y: number, title: string, meta: string) {
      const key = `${x}-${y}-${title}`;
      if (key === lastChipKey) return;
      lastChipKey = key;
      chip.style.left = `${(x / 960) * 100}%`;
      chip.style.top = `${(y / 600) * 100}%`;
      chipTitle.textContent = title;
      chipMeta.textContent = meta;
      chip.hidden = false;
      chip.classList.remove("pop");
      void chip.offsetWidth;
      chip.classList.add("pop");
    }

    function renderLedger(rows: LedgerRow[]) {
      ledger.replaceChildren(...rows.map((r, i) => {
        const li = document.createElement("li");
        if (i === 0) li.className = "is-latest";
        const cells = [r.time, r.text, r.tag].map((c) => {
          const span = document.createElement("span");
          span.textContent = c;
          return span;
        });
        li.append(...cells);
        return li;
      }));
    }

    function renderZones(t: number) {
      const states = new Map<string, ZoneState>();
      EVENTS.filter((e) => e.t <= t).forEach((e) => states.set(e.zone, e.state));
      zones.forEach((el, id) => {
        const state = states.get(id) ?? "pending";
        el.dataset.state = state;
        el.querySelector(".zone-state")!.textContent = STATE_LABEL[state];
      });
    }

    function renderProgress(t: number) {
      renderZones(t);
      sheetDay.textContent = DAYS[Math.min(4, Math.floor(t))];
      const past = EVENTS.filter((e) => e.t <= t);
      renderLedger(past.slice(-LEDGER_SIZE).reverse().map((e) => ({
        time: e.time, text: `${e.title} · Zone ${e.zone}`, tag: e.state === "done" ? "verified" : `detected · ${e.source}`,
      })));
      const latest = past[past.length - 1];
      if (!latest) { chip.hidden = true; lastChipKey = ""; return; }
      const [cx, cy] = ZONE_CENTER[latest.zone];
      showChip(cx, cy, `${latest.title} · Zone ${latest.zone}`,
        `${latest.time} · ${latest.source} · ${latest.state === "done" ? "VERIFIED BY A REVIEWER" : "DETECTED BY AI"}`);
    }

    function setMode(next: Mode) {
      mode = next;
      root.dataset.mode = next;
      tabs.forEach((tab) => {
        const selected = tab.dataset.tab === next;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panel.setAttribute("aria-labelledby", `tab-${next}`);
      svg.setAttribute("aria-label", SVG_LABEL[next]);
      scrubWrap.hidden = next !== "progress";
      if (next === "progress") {
        scrubLabel.textContent = "This week";
        note.textContent = "Drag through the week. AI detects work in progress; a zone turns complete when an Openbox reviewer verifies it.";
        sheetTitle.textContent = "LEVEL 3 — PROGRESS";
        renderProgress(Number(scrub.value));
        return;
      }
      const view = VIEWS[next];
      renderZones(4);
      sheetDay.textContent = next === "watch" ? "10:14" : "FRI";
      sheetTitle.textContent = view.title;
      scrubLabel.textContent = view.label;
      note.textContent = view.note;
      renderLedger(view.ledger);
      showChip(view.chip.x, view.chip.y, view.chip.title, view.chip.meta);
    }

    function playProgress() {
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / PROGRESS_MS);
        const t = (1 - Math.pow(1 - p, 2.2)) * 4;
        scrub.value = String(t);
        if (mode === "progress") renderProgress(t);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    function stopTour() {
      timers.forEach((id) => clearTimeout(id));
      timers.length = 0;
      cancelAnimationFrame(raf);
      ledger.setAttribute("aria-live", "polite");
    }

    function runTour() {
      let delay = 0;
      TOUR_STEPS.forEach(({ mode: m, hold }) => {
        timers.push(window.setTimeout(() => {
          if (m === "progress") { scrub.value = "0"; setMode("progress"); playProgress(); }
          else setMode(m);
        }, delay));
        delay += hold;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => { stopTour(); setMode(tab.dataset.tab as Mode); });
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        stopTour();
        setMode(next.dataset.tab as Mode);
        next.focus();
      });
    });
    scrub.addEventListener("input", () => { stopTour(); renderProgress(Number(scrub.value)); });

    setMode("twin");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        timers.push(window.setTimeout(runTour, 500));
      }
    }, { threshold: 0.35 });
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-plan]").forEach(setup);
</script>

