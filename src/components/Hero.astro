---
import { DEMO_HREF, DEMO_IS_EXTERNAL } from "../data/site";

const externalAttrs = DEMO_IS_EXTERNAL ? { target: "_blank", rel: "noopener" } : {};
const gridX = [
  { x: 140, label: "A" },
  { x: 320, label: "B" },
  { x: 500, label: "C" },
  { x: 680, label: "D" },
  { x: 840, label: "E" },
];
const gridY = [
  { y: 130, label: "1" },
  { y: 290, label: "2" },
  { y: 450, label: "3" },
];
const zones = [
  { id: "A", name: "ZONE A · CORE", x: 140, y: 130, w: 180, h: 160 },
  { id: "B", name: "ZONE B", x: 320, y: 130, w: 180, h: 160 },
  { id: "C", name: "ZONE C", x: 500, y: 130, w: 340, h: 160 },
  { id: "D", name: "ZONE D", x: 140, y: 290, w: 360, h: 160 },
  { id: "E", name: "ZONE E", x: 500, y: 290, w: 180, h: 160 },
  { id: "F", name: "ZONE F · STAIR", x: 680, y: 290, w: 160, h: 160 },
];
const cameras = [
  { id: "CAM-04", x: 104, y: 100, angle: 40, lx: 92, ly: 88, anchor: "start" },
  { id: "CAM-02", x: 876, y: 100, angle: 140, lx: 888, ly: 88, anchor: "end" },
  { id: "CAM-06", x: 104, y: 474, angle: -40, lx: 92, ly: 500, anchor: "start" },
];
const cameras2 = [{ id: "CAM-08", x: 660, y: 474, angle: -150, lx: 668, ly: 462, anchor: "start" }];
const walk = [[180, 410], [260, 340], [400, 330], [450, 230], [600, 225], [760, 340]];
const days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const modes = [
  { id: "twin", label: "Twin · Site record" },
  { id: "model", label: "Twin · 3D model" },
  { id: "progress", label: "Twin · Progress" },
  { id: "watch", label: "Watch · Site monitoring" },
];
type Pt = [number, number];
const ISO = { ox: 420, oy: 262, k: 0.95, levelH: 46, w: 360, d: 160 };
const iso = (x: number, y: number, z: number): Pt => [
  ISO.ox + (x - y) * 0.866 * ISO.k,
  ISO.oy + (x + y) * 0.5 * ISO.k - z * ISO.k,
];
const poly = (pts: Pt[]): string => pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(" ");
const top = (x0: number, y0: number, x1: number, y1: number, z: number): string =>
  poly([iso(x0, y0, z), iso(x1, y0, z), iso(x1, y1, z), iso(x0, y1, z)]);
const faceLeft = (z0: number, z1: number): string =>
  poly([iso(0, ISO.d, z0), iso(ISO.w, ISO.d, z0), iso(ISO.w, ISO.d, z1), iso(0, ISO.d, z1)]);
const faceRight = (z0: number, z1: number): string =>
  poly([iso(ISO.w, 0, z0), iso(ISO.w, ISO.d, z0), iso(ISO.w, ISO.d, z1), iso(ISO.w, 0, z1)]);
const H = ISO.levelH;
const toFoot = (x: number, y: number): Pt => [((x - 140) * ISO.w) / 700, ((y - 130) * ISO.d) / 320];
const deckState: Record<string, string> = { A: "done", B: "done", C: "progress", D: "done", E: "progress", F: "pending" };
const deckTiles = zones.map((z) => {
  const [x0, y0] = toFoot(z.x, z.y);
  const [x1, y1] = toFoot(z.x + z.w, z.y + z.h);
  return { id: z.id, state: deckState[z.id], points: top(x0 + 3, y0 + 3, x1 - 3, y1 - 3, 2 * H) };
});
const columns: Pt[] = [[0, 0], [ISO.w, 0], [ISO.w, ISO.d], [0, ISO.d], [ISO.w / 2, ISO.d], [ISO.w / 2, 0]];
const cranePts = { base: iso(400, 40, 0), mast: iso(400, 40, 4.4 * H), jibA: iso(230, 40, 4.4 * H), jibB: iso(470, 40, 4.4 * H) };
const labelAt = (x: number, y: number, z: number) => iso(x, y, z);
const cone = (x: number, y: number, angle: number): string => {
  const reach = 170;
  const spread = 22;
  const rad = (d: number) => (d * Math.PI) / 180;
  const a = rad(angle - spread);
  const b = rad(angle + spread);
  return `M${x} ${y} L${(x + reach * Math.cos(a)).toFixed(1)} ${(y + reach * Math.sin(a)).toFixed(1)} A${reach} ${reach} 0 0 1 ${(x + reach * Math.cos(b)).toFixed(1)} ${(y + reach * Math.sin(b)).toFixed(1)} Z`;
};
---
<section class="hero">
  <div class="wrap hero-copy">
    <p class="eyebrow">For general contractors and owners</p>
    <h1 class="display hero-title">Every jobsite,<br />a <em>living</em> digital twin.</h1>
    <p class="lede">
      Openbox turns every walk, drone flight and site camera into one live record of your project.
      A 3D model of what is built, milestones verified by a person, actual dates against your schedule, and the whole site monitored for safety, logistics and security on the same cameras.
    </p>
    <div class="hero-cta">
      <a class="btn btn-ink" href={DEMO_HREF} {...externalAttrs}>Book a demo</a>
      <a class="btn btn-line" href="#platform">See the platform</a>
    </div>
    <p class="sectors mono">Built for commercial, multifamily, data center and infrastructure projects</p>
  </div>

  <div class="wrap">
    <div class="stage grain-panel" data-plan data-mode="twin">
      <div class="tabs" role="tablist" aria-label="Openbox views" data-tablist>
        {modes.map((m) => (
          <button type="button" role="tab" class="tab" id={`tab-${m.id}`} aria-controls="plan-panel" data-tab={m.id} aria-selected={m.id === "twin" ? "true" : "false"} tabindex={m.id === "twin" ? "0" : "-1"}>
            <span class="tab-dot" aria-hidden="true"></span>{m.label}
          </button>
