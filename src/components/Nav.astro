---
import { DEMO_HREF, DEMO_IS_EXTERNAL } from "../data/site";

interface Props {
  /** Transparent over a dark hero until the page scrolls. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const externalAttrs = DEMO_IS_EXTERNAL ? { target: "_blank", rel: "noopener" } : {};
const links = [
  { href: `${base}#platform`, label: "Platform" },
  { href: `${base}#pilot`, label: "Pilot" },
  { href: `${base}about/`, label: "About" },
];
---
<header class:list={["nav", { "is-overlay": overlay }]} data-nav>
  <div class="wrap nav-row">
    <a class="brand" href={base} aria-label="Openbox home">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#111110" />
        <path d="M8 12.5 16 8l8 4.5v9L16 26l-8-4.5z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
        <path d="M8 12.5 16 17l8-4.5" fill="none" stroke="#d9ff42" stroke-width="2" stroke-linejoin="round" />
      </svg>
      <span>Openbox</span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="btn nav-cta" href={DEMO_HREF} {...externalAttrs}>Book a demo</a>
      <details class="mobile">
        <summary aria-label="Open menu">Menu</summary>
        <div class="mobile-panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="m-cta" href={DEMO_HREF} {...externalAttrs}>Book a demo</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav].is-overlay");
  if (nav) {
    const update = () => nav.classList.toggle("is-solid", window.scrollY > 24);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 30;
    background: rgba(255, 255, 255, .88);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background .25s ease, border-color .25s ease, color .25s ease;
  }
  .nav.is-overlay { position: fixed; left: 0; right: 0; background: transparent; border-color: transparent; color: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .nav.is-overlay.is-solid { background: rgba(12, 12, 11, .72); border-color: rgba(255,255,255,.08); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }

  .nav-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 14px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650; font-size: 19px; letter-spacing: -.01em; color: inherit; }
  .is-overlay .brand rect { stroke: rgba(255,255,255,.18); stroke-width: 1; }
  .links { display: flex; gap: 32px; align-items: center; font-size: 15px; }
  .links a { text-decoration: none; color: var(--ink-2); }
  .links a:hover { color: var(--ink); }
  .is-overlay .links a { color: rgba(255,255,255,.72); }
  .is-overlay .links a:hover { color: #fff; }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-cta { padding: 10px 15px; font-size: 14px; background: var(--ink); color: var(--paper); }
  .is-overlay .nav-cta { background: #fff; color: var(--ink); }

  .mobile { display: none; position: relative; }
  .mobile summary { list-style: none; cursor: pointer; padding: 9px 12px; border: 1px solid var(--line-strong); border-radius: 10px; font-size: 14px; }
  .is-overlay .mobile summary { border-color: rgba(255,255,255,.3); }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile-panel { position: absolute; right: 0; top: calc(100% + 8px); width: min(260px, calc(100vw - 40px)); background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: 14px; padding: 8px; display: grid; box-shadow: 0 30px 60px -30px rgba(0,0,0,.35); }
  .mobile-panel a { padding: 10px 12px; border-radius: 8px; text-decoration: none; font-size: 15px; }
  .mobile-panel a:hover { background: var(--stone); }
  .mobile-panel .m-cta { margin-top: 6px; background: var(--ink); color: var(--paper); text-align: center; font-weight: 600; }

  @media (max-width: 760px) {
    .links { display: none; }
    .mobile { display: block; }
  }
  @media (max-width: 480px) {
    .nav-cta { display: none; }
  }
</style>
