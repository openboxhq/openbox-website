---
import { CONTACT_HREF, DEMO_HREF, DEMO_IS_EXTERNAL } from "../data/site";
import { PLANS, PRICING_NOTES } from "../data/pricing";

const principles = [
  { k: "Most cameras", v: "Most IP cameras (RTSP or ONVIF), 360° walk video, drone and phone video. No locked-in hardware." },
  { k: "Between walks", v: "Fixed cameras report work the day it happens. Interiors update on walk day." },
  { k: "Verified", v: "AI detects the work. An Openbox reviewer verifies each milestone, with the clip as evidence." },
  { k: "Plain pricing", v: "Watch from $99 per site. Twin from $990 per project. Unlimited users, free for 30 days." },
];
const MONITORING = [
  { id: "safety", title: "Safety", items: ["PPE: hard hats, hi-vis, harnesses", "Crane swing and equipment exclusion zones", "Falls, open edges and work at height", "Fire, smoke and hot work"] },
  { id: "logistics", title: "Logistics", items: ["Gate log with plate reading", "Deliveries matched to the schedule", "Truck turnaround and dwell time", "Headcount by shift and trade"] },
  { id: "security", title: "Security", items: ["After-hours intrusion alerts", "Theft and asset removal", "Loitering and fence breaches", "Reviewed by a person, then your team or guard is notified"] },
  { id: "visibility", title: "Site visibility", items: ["Live view across every camera", "Time-lapse by level and zone", "Camera health and tamper alerts", "Search and evidence clips"] },
];
const externalAttrs = DEMO_IS_EXTERNAL ? { target: "_blank", rel: "noopener" } : {};
---
<section class="section monitoring" id="monitoring">
  <div class="wrap">
    <div class="mon-head">
      <p class="eyebrow">Jobsite monitoring · Openbox Watch</p>
      <h2 class="display">Everything your site cameras see, put to work.</h2>
      <p class="lede">The cameras that record progress also watch for safety risks, track the gate and crews, and secure the site after hours. A person reviews each alert before your team is notified.</p>
    </div>
    <div class="mon-grid">
      {MONITORING.map((m) => (
        <div class="mon-col" id={m.id}>
          <span class="mon-k">{m.title}</span>
          <ul>{m.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section built">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow">Built on Dragonfruit AI</p>
      <h2 class="display">New to construction.<br />Not new to video AI.</h2>
      <p class="lede">Openbox runs on Dragonfruit AI's production video AI platform, which monitors more than 100,000 live cameras.</p>
    </div>
    <div class="principles">
      {principles.map((p) => (
        <div class="principle">
          <span class="p-k">{p.k}</span>
          <span class="p-v">{p.v}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section pricing" id="pricing">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow">Pricing</p>
      <h2 class="display">Priced per jobsite.<br />Never per seat.</h2>
      <p class="lede">Start with jobsite monitoring, the digital twin, or both. Bring your whole team, your trades and your owner: every plan has unlimited users and starts free for 30 days.</p>
    </div>
    <div class="plans">
      {PLANS.map((plan) => (
        <article class={`plan${plan.featured ? " featured" : ""}`}>
          <header>
            <span class="plan-name mono">{plan.name} · {plan.tagline}</span>
            <span class="plan-price"><span class="amount">{plan.price}</span><span class="unit">{plan.unit}</span></span>
            <p>{plan.pitch}</p>
          </header>
          <ul>{plan.features.map((f) => <li>{f}</li>)}</ul>
          <a class={`btn ${plan.featured ? "btn-signal" : "btn-line"}`} href={`${DEMO_HREF}?interest=${plan.interest}`}>{plan.cta}</a>
        </article>
      ))}
    </div>
    <ul class="plan-notes mono">{PRICING_NOTES.map((n) => <li>{n}</li>)}</ul>
  </div>
</section>

<section class="section contact-sec" id="contact">
  <div class="wrap contact-grid">
    <div class="contact-card">
      <p class="eyebrow">See it on your project</p>
      <h2 class="display">Book a demo</h2>
      <p>Tell us about your projects. We reply within one business day to set up a 30-minute call on a project like yours.</p>
      <a class="btn btn-ink" href={DEMO_HREF} {...externalAttrs}>Request a demo</a>
    </div>
    <div class="contact-card">
      <p class="eyebrow">Talk to the company</p>
      <h2 class="display">Contact us</h2>
      <p>Partnerships, camera and tower vendors, press, investors or careers. Send us a note and the right person replies.</p>
      <a class="btn btn-line" href={CONTACT_HREF}>Send us a note</a>
    </div>
  </div>
</section>

<style>
  .monitoring { background: var(--night) var(--grain); color: #f1f1ec; }
  .monitoring .eyebrow { color: #a3a39b; }
  .monitoring .lede { color: #c9c9c2; }
  .mon-head { display: grid; gap: 16px; margin-bottom: 44px; max-width: 780px; }
  .mon-head .display { font-size: clamp(36px, 4.6vw, 56px); }
  .mon-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #3a3a37; }
  .mon-col { padding: 22px 20px 0 0; scroll-margin-top: 120px; }
  .mon-col + .mon-col { padding-left: 20px; border-left: 1px solid #34342f; }
  .mon-k { font-family: var(--serif); font-size: 30px; }
  .mon-col ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; font-size: 15px; color: #d4d4cd; }
  .mon-col li { padding-left: 16px; position: relative; }
  .mon-col li::before { content: ""; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); }

  .center { justify-items: center; text-align: center; }
  .principles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .principle { display: grid; gap: 8px; padding: 22px 20px 0 0; align-content: start; }
  .principle + .principle { padding-left: 20px; border-left: 1px solid var(--line); }
  .p-k { font-family: var(--serif); font-size: 28px; line-height: 1.1; }
  .p-v { color: var(--ink-2); font-size: 15px; }

  .pricing { padding-top: 0; }
  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .plan { display: grid; grid-template-rows: auto 1fr auto; gap: 22px; padding: clamp(22px, 3vw, 32px); border: 1px solid var(--line); border-radius: 20px; background: var(--paper); }
  .plan header { display: grid; gap: 10px; }
  .plan header p { margin: 0; color: var(--ink-2); }
  .plan-name { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .plan-price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .amount { font-family: var(--serif); font-size: 46px; line-height: 1; }
  .unit { color: var(--ink-2); font-size: 14px; }
  .plan ul { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; align-content: start; font-size: 15px; }
  .plan li { padding-left: 22px; position: relative; }
  .plan li::before { content: "✓"; position: absolute; left: 0; font-family: var(--mono); font-size: 13px; color: var(--ink); }
  .plan .btn { justify-self: start; }
  .plan.featured { background: var(--night) var(--grain); color: #f1f1ec; border-color: var(--night); box-shadow: 0 30px 60px -30px rgba(0,0,0,.45); }
  .plan.featured header p, .plan.featured .unit, .plan.featured .plan-name { color: #c4c4bc; }
  .plan.featured ul { border-top-color: #34342f; color: #e6e6df; }
  .plan.featured li::before { color: var(--signal); }
  .btn-signal { background: var(--signal); color: var(--ink); }
  .btn-signal:hover { background: #e6ff7a; }
  .plan-notes { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: center; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }

  .contact-sec { border-top: 1px solid var(--line); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .contact-card { display: grid; gap: 14px; justify-items: start; padding: clamp(24px, 4vw, 44px); border: 1px solid var(--line); border-radius: 20px; }
  .contact-card:first-child { background: var(--stone) var(--grain); }
  .contact-card .display { font-size: clamp(34px, 4vw, 48px); }
  .contact-card p { margin: 0; color: var(--ink-2); max-width: 44ch; }

  @media (max-width: 1100px) {
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); }
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mon-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 24px; }
    .mon-col:nth-child(3) { border-left: 0; padding-left: 0; }
    .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principle:nth-child(3) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 520px) {
    .plans { grid-template-columns: minmax(0, 1fr); }
    .mon-grid { grid-template-columns: minmax(0, 1fr); }
    .mon-col + .mon-col { border-left: 0; padding-left: 0; }
    .principles { grid-template-columns: minmax(0, 1fr); }
    .principle + .principle { border-left: 0; padding-left: 0; }
  }
</style>
