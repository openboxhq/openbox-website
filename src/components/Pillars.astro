---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pillars = [
  { n: "01", k: "Progress", title: "Know what was built today.", line: "A dated record of every day on site, checked against your schedule." },
  { n: "02", k: "Safety", title: "Catch risk between walks.", line: "PPE, exclusion zones and open edges, flagged with the clip." },
  { n: "03", k: "Security", title: "Own the night.", line: "After-hours alerts, reviewed by a person before they reach you." },
];
---
<section class="section pillars" id="platform">
  <div class="wrap">
    <h2 class="display p-head">One camera network.<br /><em>Every job on site.</em></h2>
    <div class="p-grid">
      {pillars.map((p) => (
        <article class="p-tile">
          <span class="p-k mono">{p.n} {p.k}</span>
          <h3 class="display">{p.title}</h3>
          <p>{p.line}</p>
        </article>
      ))}
    </div>
    <div class="proof">
      <span class="proof-n display">100,000+</span>
      <span class="proof-t">live cameras run on the Dragonfruit AI video platform that powers Openbox.</span>
      <a class="proof-df" href="https://dragonfruit.ai/" target="_blank" rel="noopener">
        <img src={`${base}images/brand/dragonfruit-logo-ink.svg`} alt="Dragonfruit AI" width="150" height="27" />
      </a>
    </div>
  </div>
</section>

<style>
  .p-head { font-size: clamp(40px, 6vw, 76px); margin: 0 0 64px; }
  .p-head em { color: var(--ink-3); }
  .p-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
  .p-tile { padding: 28px 28px 8px 0; display: grid; gap: 14px; align-content: start; }
  .p-tile + .p-tile { padding-left: 28px; border-left: 1px solid var(--line); }
  .p-k { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .p-tile h3 { font-size: clamp(28px, 2.8vw, 36px); line-height: 1.05; margin: 0; }
  .p-tile p { margin: 0; color: var(--ink-2); max-width: 30ch; }
  .proof {
    margin-top: 96px; padding-top: 28px; border-top: 1px solid var(--line);
    display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap;
  }
  .proof-n { font-size: clamp(40px, 5vw, 60px); line-height: 1; }
  .proof-t { color: var(--ink-2); max-width: 46ch; flex: 1 1 280px; }
  .proof-df img { display: block; height: 27px; width: auto; opacity: .85; }
  .proof-df:hover img { opacity: 1; }
  @media (max-width: 820px) {
    .p-grid { grid-template-columns: 1fr; }
    .p-tile, .p-tile + .p-tile { padding: 26px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }
</style>
