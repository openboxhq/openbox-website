---
import { DEMO_HREF, DEMO_IS_EXTERNAL } from "../data/site";

const externalAttrs = DEMO_IS_EXTERNAL ? { target: "_blank", rel: "noopener" } : {};
---
<section class="hv">
  <canvas class="hv-canvas" aria-hidden="true" data-scene></canvas>
  <div class="hv-shade" aria-hidden="true"></div>
  <div class="wrap hv-copy">
    <p class="eyebrow hv-kicker"><span class="signal-dot"></span>Construction intelligence</p>
    <h1 class="display hv-title">Rewind the site<br /><em>to any day.</em></h1>
    <p class="hv-lede">Visual change control for the site itself. Headcams, drones and site cameras keep every day on one timeline of progress, safety and security.</p>
    <div class="hv-cta">
      <a class="btn hv-primary" href={DEMO_HREF} {...externalAttrs}>Book a demo</a>
      <a class="hv-link" href="#pilot">Free 30-day pilot →</a>
    </div>
  </div>
  <p class="wrap hv-foot mono">Commercial · Industrial · Infrastructure</p>
</section>

<script>
  import { startJobsiteScene } from "../scripts/jobsite-scene";
  const canvas = document.querySelector<HTMLCanvasElement>("[data-scene]");
  if (canvas) startJobsiteScene(canvas);
</script>

<style>
  .hv {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(640px, 100svh);
    display: grid; align-content: center;
    background: radial-gradient(120% 90% at 70% 45%, #1d1d1b 0%, #0c0c0b 60%, #080807 100%);
    color: #fff;
  }
  .hv-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .hv-shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(8,8,7,.86) 0%, rgba(8,8,7,.45) 42%, rgba(8,8,7,0) 70%),
      linear-gradient(0deg, rgba(8,8,7,.7) 0%, rgba(8,8,7,0) 30%),
      var(--grain);
  }
  .hv-copy { width: 100%; padding-top: 96px; padding-bottom: 72px; }
  .hv-kicker { display: inline-flex; align-items: center; gap: 10px; color: rgba(255,255,255,.62); margin: 0 0 22px; }
  .hv-title { font-size: clamp(56px, 9vw, 128px); line-height: .94; margin: 0 0 26px; }
  .hv-title em { color: var(--signal); }
  .hv-lede { font-size: clamp(17px, 1.6vw, 21px); color: rgba(255,255,255,.72); max-width: 34ch; margin: 0 0 34px; text-wrap: pretty; }
  .hv-cta { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
  .hv-primary { background: #fff; color: var(--ink); }
  .hv-primary:hover { background: var(--signal); }
  .hv-link { color: rgba(255,255,255,.82); text-decoration: none; font-size: 15px; }
  .hv-link:hover { color: #fff; }
  .hv-foot {
    position: absolute; left: 0; right: 0; bottom: 26px;
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.45);
  }
  @media (max-width: 760px) {
    .hv { align-content: start; }
    .hv-shade { background: linear-gradient(180deg, rgba(8,8,7,.88) 0%, rgba(8,8,7,.55) 48%, rgba(8,8,7,.2) 100%), var(--grain); }
    .hv-copy { padding-top: 156px; }
  }
</style>
