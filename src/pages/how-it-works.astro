---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/PageHero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import SceneBand from "../components/SceneBand.astro";
import Engines from "../components/Engines.astro";
import CompareMatrix from "../components/CompareMatrix.astro";
import Pilot from "../components/Pilot.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="How Openbox works: progress, safety and security"
  description="Drones, site walks and site cameras feed one dated record of your construction site. Openbox reads it for progress, safety and security."
>
  <Nav overlay adaptive />
  <main>
    <PageHero eyebrow="How it works" image="progress">
      <Fragment slot="title">Capture once.<br /><em>Know everything.</em></Fragment>
      <Fragment slot="lede">Drones, site walks and site cameras feed one dated record of your site. Openbox reads it for progress, safety and security.</Fragment>
    </PageHero>
    <SceneBand />
    <HowItWorks />
    <Engines />
    <CompareMatrix />
    <Pilot />
  </main>
  <Footer />
</Base>
