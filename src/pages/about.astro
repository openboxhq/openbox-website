---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/PageHero.astro";
import Pilot from "../components/Pilot.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Advisor {
  name: string;
  role: string;
  photo: string;
  linkedin: string;
}
const advisors: Advisor[] = [
  { name: "Amit Kumar", role: "Founder and CEO, Dragonfruit AI", photo: "images/advisors/amit-kumar.jpg", linkedin: "https://www.linkedin.com/in/amitkumar/" },
  { name: "Shivang Agarwal", role: "Head of Engineering, Dragonfruit AI", photo: "images/advisors/shivang-agarwal.jpg", linkedin: "https://www.linkedin.com/in/shivang-agarwal/" },
];

const beliefs = [
  { k: "Evidence over reports.", v: "Every decision rests on the clip, the date and the place." },
  { k: "One network, every job.", v: "By day, the camera records progress. By night, it guards the site." },
  { k: "A person in the loop.", v: "AI finds the work and the risks. A person confirms them." },
];
---
<Base
  title="About Openbox: a Dragonfruit AI company"
  description="Openbox gives everyone who builds a true, live record of their site. It is a Dragonfruit AI company."
>
  <Nav overlay />
  <main>
    <PageHero eyebrow="Our mission">
      <Fragment slot="title">Every change on site<br /><em>deserves a record.</em></Fragment>
      <Fragment slot="lede">Construction runs on video now. Openbox turns it into one live record of every site, so the people who build can see what happened, when and where.</Fragment>
    </PageHero>

    <section class="section">
      <div class="wrap beliefs">
        {beliefs.map((b, i) => (
          <div class="belief">
            <span class="b-n mono">0{i + 1}</span>
            <span class="b-k display">{b.k}</span>
            <span class="b-v">{b.v}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section advisors">
      <div class="wrap">
        <p class="eyebrow a-k">Advisors</p>
        <h2 class="display a-head">Advised by the team<br /><em>behind Dragonfruit AI.</em></h2>
        <div class="advisor-grid">
          {advisors.map((a) => (
            <a class="advisor" href={a.linkedin} target="_blank" rel="noopener" aria-label={`${a.name} on LinkedIn`}>
              <img src={`${base}${a.photo}`} alt={`Portrait of ${a.name}`} width="480" height="480" loading="lazy" />
              <span class="a-name">{a.name}</span>
              <span class="a-role mono">Advisor · {a.role}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Pilot />
  </main>
  <Footer />
</Base>

<style>
  .beliefs { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
  .belief { display: grid; gap: 12px; align-content: start; padding: 28px 28px 8px 0; }
  .belief + .belief { padding-left: 28px; border-left: 1px solid var(--line); }
  .b-n { font-size: 12px; letter-spacing: .14em; color: var(--ink-3); }
  .b-k { font-size: clamp(28px, 2.8vw, 36px); line-height: 1.05; }
  .b-v { color: var(--ink-2); max-width: 30ch; }

  .advisors { padding-top: 0; }
  .a-k { margin: 0 0 14px; }
  .a-head { font-size: clamp(36px, 5vw, 60px); margin: 0 0 48px; }
  .a-head em { color: var(--ink-3); }
  .advisor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 280px)); gap: 24px; }
  .advisor { display: grid; gap: 6px; text-decoration: none; color: inherit; }
  .advisor img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 16px; border: 1px solid var(--line); filter: grayscale(1) contrast(1.05); transition: filter .3s ease; margin-bottom: 8px; }
  .advisor:hover img { filter: none; }
  .a-name { font-family: var(--serif); font-size: 28px; line-height: 1.1; }
  .a-role { font-size: 12px; letter-spacing: .06em; color: var(--ink-3); }

  @media (max-width: 820px) {
    .beliefs { grid-template-columns: 1fr; }
    .belief, .belief + .belief { padding: 26px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .advisor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .a-name { font-size: 22px; }
  }
</style>
